    {static} +choiceSeed(gameSeed : long, arrivalIndex : int) : long
    {abstract} +typeLabel() : String
    {abstract} #satisfactionLossPerTurn() : int
    +applyCustomerPricing(priceCents : long) : long
    #onServed(turn : int) : String
